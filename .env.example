# Preferred: server-side keys (Vite proxy locally, Vercel /api/extract in production).
# Do not prefix with VITE_ — that would expose the key to the browser bundle.

# Document extract uses OpenAI GPT-4o (json_object) via /api/extract.
# Production (Vercel): set OPENAI_API_KEY in Project → Settings → Environment Variables
# for Production, Preview, and Development. Never prefix with VITE_.
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# Optional local fallback pasted in Settings. Never synced.

# Intel parse still uses Anthropic when configured:
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional extra public RSS / Atom / CAP URLs for /api/alerts/missing (comma-separated).
# NCMEC national missing-children-alert RSS is always included.
# MISSING_ALERT_FEEDS=https://example.gov/alerts.atom
